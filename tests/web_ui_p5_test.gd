extends SceneTree

const Shell = preload("res://scripts/web_ui/web_ui_shell.gd")
const Adventure = preload("res://scripts/web_ui/web_adventure_screen.gd")
var checks: int=0
var fails: Array[String]=[]

func verify(condition: bool, description: String) -> void:
    checks+=1
    if not condition:
        fails.append(description)
        printerr("WEB_UI_P5 FAIL: "+description)

func _initialize() -> void:
    call_deferred("_run")

func _run() -> void:
    if OS.get_environment("SCE_WEB_UI_ISOLATED_TEST")!="1":
        quit(2)
        return
    root.size=Vector2i(960,540)
    var game=load("res://main.tscn").instantiate()
    root.add_child(game)
    for i in range(5):
        await process_frame
    game._hide_title_screen()
    var ui: Region1RunUI=game.region_run_ui
    ui.run.save_path="user://web_p5_disposable_fixture.json"
    var helper=load("res://tests/hub_inventory_analysis_test.gd").new()
    verify(ui.run.adopt_initial(helper.make_items(ui.run.roller,517901)),"disposable six-item loadout")
    helper.free()
    verify(ui.run.begin(20261015,1),"start isolated run")
    var shell=Shell.new()
    root.add_child(shell)
    await process_frame
    var adventure=Adventure.new()
    adventure.bind_host(game)
    verify(shell.register_screen("adventure",adventure),"Web adventure registered")
    game.web_ui_shell=shell
    game.web_adventure_screen=adventure
    verify(shell.activate("adventure"),"Web adventure active")
    adventure.refresh()
    verify(adventure.options.size()>0 and adventure._phase()=="route","route offers visible")
    var save_before: String=FileAccess.get_file_as_string(ui.run.save_path)
    var phase_before: String=str(ui.run.state.phase)
    adventure._tap_choice(0)
    verify(str(ui.run.state.phase)==phase_before and FileAccess.get_file_as_string(ui.run.save_path)==save_before,"route first tap does not save")
    verify(not adventure.description.text.is_empty(),"route tap shows preview")
    adventure._tap_choice(0)
    verify(str(ui.run.state.phase)=="battle","second route tap starts battle")
    verify(not shell.selection.commit_pending,"route commit lock released")

    # Exercise non-combat phases using the controller's validated save format
    # and representative equipment generated by the official drop policy.
    var controller=ui.run
    var test_item: Dictionary=controller.state.inventory.values()[0].duplicate(true)
    var next: Dictionary=controller.state.duplicate(true)
    next.phase="reward"
    next.run.kind="chest"
    next.run.rewards=[test_item.duplicate(true)]
    next.run.battle={}
    verify(controller._commit(next),"create validated chest reward fixture")
    adventure.refresh()
    verify(adventure._phase()=="reward" and adventure.details!=null,"reward view open")
    var reward_before: String=FileAccess.get_file_as_string(controller.save_path)
    adventure._tap_choice(0)
    verify(FileAccess.get_file_as_string(controller.save_path)==reward_before,"reward preview does not mutate save")
    verify(adventure.details.current_cards.size()==4,"reward item shows four cards")
    adventure.details.view_card(2)
    verify(not adventure.details.formal.text.is_empty(),"reward card detail is read-only")
    verify(FileAccess.get_file_as_string(controller.save_path)==reward_before,"card description does not acquire reward")
    adventure._tap_choice(0)
    verify(str(controller.state.phase)=="route" and controller.state.run.bag.size()==1,"reward second tap stores loot once")
    verify(not shell.selection.commit_pending,"reward lock released")

    next=controller.state.duplicate(true)
    next.phase="service"
    next.run.kind="event"
    verify(controller._commit(next),"create event fixture")
    adventure.refresh()
    var gold_before: int=int(controller.state.run.gold)
    var event_before: String=FileAccess.get_file_as_string(controller.save_path)
    adventure._tap_choice(0)
    verify(FileAccess.get_file_as_string(controller.save_path)==event_before,"event preview does not add Gold")
    adventure._tap_choice(0)
    verify(int(controller.state.run.gold)==gold_before+80 and str(controller.state.phase)=="route","event choice awards Gold exactly once")

    next=controller.state.duplicate(true)
    next.phase="service"
    next.run.kind="rest"
    next.run.hp=mini(int(next.run.hp),int(next.run.max_hp)-10)
    verify(controller._commit(next),"create rest fixture")
    adventure.refresh()
    var hp_before: int=int(controller.state.run.hp)
    adventure._tap_choice(0)
    verify(int(controller.state.run.hp)==hp_before,"rest preview does not heal")
    adventure._tap_choice(0)
    verify(int(controller.state.run.hp)>hp_before and str(controller.state.phase)=="route","rest confirms healing exactly once")

    next=controller.state.duplicate(true)
    next.phase="service"
    next.run.kind="shop"
    next.run["shop_npc"]="merchant"
    next.run.stock=[test_item.duplicate(true)]
    verify(controller._commit(next),"create run merchant fixture")
    adventure.refresh()
    var shop_gold: int=int(controller.state.run.gold)
    adventure._tap_choice(0)
    verify(shop_gold==int(controller.state.run.gold),"merchant first tap does not charge")
    verify(adventure.details.current_cards.size()==4,"run merchant item details")
    adventure._tap_choice(0)
    verify(int(controller.state.run.gold)==shop_gold-280 and controller.state.run.bag.size()==2,"merchant confirm charges 280 once")
    verify(controller.state.run.stock[0].is_empty(),"merchant item sold out")

    next=controller.state.duplicate(true)
    next.phase="service"
    next.run.kind="shop"
    next.run["shop_npc"]="priest"
    next.run.stock=[]
    next.run.hp=mini(int(next.run.hp),int(next.run.max_hp)-10)
    verify(controller._commit(next),"create priest fixture")
    adventure.refresh()
    var priest_gold: int=int(controller.state.run.gold)
    adventure._tap_choice(2) # Attack support, 60G
    verify(int(controller.state.run.gold)==priest_gold,"priest support preview is read-only")
    adventure._tap_choice(2)
    verify(int(controller.state.run.gold)==priest_gold-60,"priest support charged once")
    verify(int(controller.state.run.support.get("attack",0))==1,"priest support registered")

    next=controller.state.duplicate(true)
    next.phase="defeat"
    next.run.hp=0
    next.run.battle={}
    next.run.body_cap=2
    verify(controller._commit(next),"create defeat fixture")
    adventure.refresh()
    verify(adventure._phase()=="defeat" and controller.state.run.bag.size()==2,"defeat gear listed")
    adventure._inspect_bag(0)
    verify(adventure.details.current_cards.size()==4,"defeat gear detail view")
    var defeat_before: String=FileAccess.get_file_as_string(controller.save_path)
    adventure._toggle_retained(true,0)
    verify(FileAccess.get_file_as_string(controller.save_path)==defeat_before,"retain toggle never saves")
    verify(adventure.chosen_retained.size()==1,"retain selection stored locally")
    var return_index: int=adventure.options.size()-1
    adventure._tap_choice(return_index)
    verify(FileAccess.get_file_as_string(controller.save_path)==defeat_before,"first return tap cannot exit")
    adventure._tap_choice(return_index)
    verify(str(controller.state.phase)=="hub","second return tap resolves defeat")
    verify(controller.state.inventory.has(str(test_item.get("instance_id",""))),"retained reward added to base inventory")
    verify(not shell.selection.commit_pending,"return lock released")

    game.queue_free()
    shell.queue_free()
    await process_frame
    print("WEB_UI_P5 PASS=%d FAIL=%d" % [checks-fails.size(),fails.size()])
    quit(0 if fails.is_empty() else 1)
